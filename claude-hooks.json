{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["idle"] }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["working"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["idle"] }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "agent_needs_input",
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["attention"] }
        ]
      },
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["attention"] }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["clear"] }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["agent_start"] }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["agent_stop"] }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["quota_error"] }
        ]
      },
      {
        "matcher": "billing_error",
        "hooks": [
          { "type": "command", "command": "__CLAUDE_STATE_SCRIPT__", "args": ["quota_error"] }
        ]
      }
    ]
  }
}
